# pipenv
Pipfile.lock

# uv lockfile — tracked in this repo for reproducibility, but defensively
# ignored here so a stale untracked copy generated by ``uv lock`` in a
# downstream daemon directory cannot block ``git checkout`` during
# version-switching upgrades. See Plan 00104 Phase 2 Task 2.3 (Issue #3
# from the 2026-05-01 field report). The skill ``upgrade.sh`` does the
# active cleanup; this ignore is a belt-and-braces guard.
uv.lock

# PEP 582
__pypackages__/

# Celery stuff
celerybeat-schedule
celerybeat.pid

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Editor / merge / backup detritus (Plan 00200 Task 6.1).
# `.bak.*` is load-bearing, not belt-and-braces: the daemon itself writes
# `settings.json.bak.pre-registration-repair` at runtime
# (utils/settings_repair.py:34), so this shape appears in real working trees
# and would otherwise be swept in by a `git add -A`.
*.bak
*.bak.*
*.orig
*.rej
*~

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# Ruff cache
.ruff_cache/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# GitHub workflows (requires OAuth scope we don't have)
.github/workflows/

# Temporary/generated docs (keep only final summaries)
COVERAGE_REPORT.md
PHASE-*.md
STATUS.md
WORK_COMPLETED.md
verify-*.sh

# Development artifacts and QA outputs
untracked/

# Claude Code managed worktrees (path not configurable, must be gitignored)
.claude/worktrees/

# Scheduled-tasks runtime lock (ScheduleWakeup/cron mechanism)
.claude/scheduled_tasks.lock

# Acceptance test results
CLAUDE/AcceptanceTests/results/*
!CLAUDE/AcceptanceTests/results/.gitkeep

# ClaudeMdInjector backup (written before each injection to enable recovery)
.CLAUDE.md.pre-inject

# Secret word lists for the sensitive_content handler — never tracked. A
# term in one of these files must never reach git history; this rule ships
# BEFORE any such file is created so a broad `git add` can never catch one.
*.secret
*.secrets
