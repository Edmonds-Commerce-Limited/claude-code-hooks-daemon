#!/usr/bin/env bash
# claude-supervise — launch the packaged PTY supervisor (Plan 00135) around a
# child command, using the hooks-daemon venv so the package imports cleanly.
#
# Use as a ccy launch wrapper (dogfooding path — no image rebuild needed because
# the project is bind-mounted at /workspace inside the container):
#
#   CCY_CLAUDE_WRAPPER="/workspace/scripts/claude-supervise --" ccy
#
# The supervisor defaults to --dry-run (transparent passthrough, no injection).
# Everything after the first `--` is the wrapped command's own argv, supplied by
# the ccy entrypoint (e.g. `claude --dangerously-skip-permissions ...`).
set -euo pipefail

project_dir="${CLAUDE_PROJECT_DIR:-/workspace}"

# Resolve a daemon venv python. The venv dir is fingerprint-keyed
# (untracked/venv-<slug>-py<MM>-<fingerprint>/), so glob rather than hardcode.
venv_python=""
for candidate in "$project_dir"/untracked/venv-*/bin/python; do
    if [ -x "$candidate" ]; then
        venv_python="$candidate"
        break
    fi
done

if [ -z "$venv_python" ]; then
    echo "claude-supervise: no daemon venv found under ${project_dir}/untracked/" >&2
    echo "  (is the hooks daemon installed for this project?)" >&2
    exit 1
fi

exec "$venv_python" -m claude_code_hooks_daemon.supervise "$@"
