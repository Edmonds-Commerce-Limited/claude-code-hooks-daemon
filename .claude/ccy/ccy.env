# ccy.env — per-project ccy environment.
#
# Sourced INSIDE the disposable ccy container by the ccy entrypoint
# (fedora-desktop), never on the host. This is the neat, tracked, declarative
# way to set per-project ccy/Claude env — no ad-hoc `CCY_CLAUDE_WRAPPER=... ccy`
# exports at the shell.
#
# SECURITY: because it is sourced in-container (the same sandbox where
# `claude --dangerously-skip-permissions` already runs arbitrary code), a
# project cannot use this file to execute code on your host.

# --- Plan 00135 PTY supervisor ---------------------------------------------
# v0: TRANSPARENT passthrough, DRY-RUN — it wraps Claude and logs that it is
# active (untracked/supervise/decision.log) but injects NOTHING yet.
#
# Standalone, stdlib-only script run directly by the container's system
# python3 — it does NOT import claude_code_hooks_daemon and does NOT need the
# daemon venv, so a daemon upgrade/breakage can never take down `ccy` launches.
#
# This supervises every ccy session for this project. Host env or
# `ccy --supervise` override it via the ${VAR:-...} default below.
#
# To DISABLE: comment the next line (or `git checkout .claude/ccy/ccy.env`) and
# relaunch ccy.
export CCY_CLAUDE_WRAPPER="${CCY_CLAUDE_WRAPPER:-/workspace/.claude/ccy/claude-supervise.py --}"
