# ccy.env — per-project ccy environment.
#
# Sourced INSIDE the disposable ccy container by the ccy entrypoint
# (fedora-desktop), never on the host. This is the neat, tracked, declarative
# way to set per-project ccy/Claude env — no ad-hoc `CCY_CLAUDE_WRAPPER=... ccy`
# exports at the shell.
#
# SECURITY: because it is sourced in-container (the same sandbox where
# `claude --dangerously-skip-permissions` already runs arbitrary code), a
# project cannot use this file to execute code on your host.

# --- Plan 00135 PTY supervisor ---------------------------------------------
# ARMED: the supervisor watches the daemon-written context sidecar and, when the
# context goes RED and the session is idle, injects a REAL `/compact`; on any
# compaction (its own OR a manual /compact) it injects `continue` to resume.
# Supervisor-injected prompts are prefixed `🤖 [ccy-supervisor]` so they are
# obviously bot messages, never mistaken for human typing.
#
# Standalone, stdlib-only script run directly by the container's system
# python3 — it does NOT import claude_code_hooks_daemon and does NOT need the
# daemon venv, so a daemon upgrade/breakage can never take down `ccy` launches.
#
# This supervises every ccy session for this project. Host env or
# `ccy --supervise` override it via the ${VAR:-...} default below.
#
# To go back to DRY-RUN (inject a harmless visible marker instead of a real
# /compact): drop the `--arm` below. To DISABLE entirely: comment the next line
# (or `git checkout .claude/ccy/ccy.env`). Either way, relaunch ccy.
#
# Self-locating: the `$(cd ... && pwd)` resolves this file's own directory at
# source time, so the same line works for the podman `/workspace` mount AND an
# arbitrary LXC project dir — no hardcoded mount path (matches what the daemon's
# ccy deploy writes into client projects).
export CCY_CLAUDE_WRAPPER="${CCY_CLAUDE_WRAPPER:-$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)/claude-supervise.py --arm --}"
