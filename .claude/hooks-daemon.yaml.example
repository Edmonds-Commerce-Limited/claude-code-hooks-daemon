version: "2.0"

# Daemon configuration
daemon:
  idle_timeout_seconds: 600  # Auto-shutdown after 10 minutes of inactivity
  log_level: INFO
  project_root: ../../  # Project root relative to this config file (always ../../)

  stale_file_days: 7  # Remove daemon runtime files older than this (days)

  # Path exclusion for content-scanning blockers (v3.35.0+, Plan 00150)
  # Gitignore-style globs (*, ?, ** = zero-or-more segments) exempted from ALL
  # three content blockers at once: security_antipattern, qa_suppression,
  # error_hiding_blocker. Set once here; each handler inherits it on top of its
  # own options.exclude_paths and built-in defaults. Use for QA/linting projects
  # whose fixtures intentionally contain "bad" code. Default: [] (no exclusions).
  # exclude_paths:
  #   - "**/fixtures/**"
  #   - "**/__fixtures__/**"
  #   - "samples/**"

  # CI enforcement (v2.27.0+) - Controls behaviour when daemon cannot start
  # Default (false/omitted): fail open — warn once then silently passthrough
  # When true: fail closed — block all tool use and tell agent to stop
  # ci_enabled: false

  # Input validation (v2.2.0+) - Catch malformed events at front controller layer
  input_validation:
    enabled: true              # Validate hook inputs (recommended)
    strict_mode: true          # Fail-closed: return errors on validation failures
    log_validation_errors: true

# Built-in handler configuration
# Handlers run in priority order (lower number = earlier execution)
# Priority ranges: 5=test, 10-20=safety, 25-45=workflow, 50-60=tool usage
handlers:
  # PreToolUse handlers (run before every tool call)
  pre_tool_use:
    # SAFETY HANDLERS (Priority 10-20) - HIGHLY RECOMMENDED
    destructive_git:       # Blocks git reset --hard, git clean -f, etc
      enabled: true
      priority: 10

    daemon_location_guard: # Prevents cd into .claude/hooks-daemon (run commands from project root)
      enabled: true
      priority: 11

    sed_blocker:           # Blocks sed command usage (use Edit tool instead)
      enabled: true
      priority: 11

    absolute_path:         # Enforces absolute paths in file operations
      enabled: true
      priority: 12

    error_hiding_blocker:  # Blocks error-hiding patterns (|| true, empty catch, except: pass, etc.)
      enabled: true
      priority: 13

    curl_pipe_shell:       # Blocks dangerous curl | sh patterns
      enabled: true
      priority: 14

    security_antipattern:  # Blocks hardcoded secrets and injection patterns
      enabled: true
      priority: 15

    write_clobber_guard:   # Blocks Write to an existing file not read this session
      enabled: true         # New files and Edits are unaffected. `Read` the file to proceed —
      priority: 16          # that is the remedy, so no escape hatch exists or is needed.

    artifact_publish_blocker:  # Blocks publishing artefacts (a claude.ai URL outside the project)
      enabled: true         # Read-only `action: "list"` is never blocked. No agent-side escape
      priority: 14          # hatch by design — only a human sets this to false.

    sensitive_content:     # Blocks configured public patterns + a gitignored secret word list
      enabled: true         # Inert until configured: public_patterns defaults to [] and the
      priority: 14          # secret word list path defaults to a file that does not exist yet.
      # options:
      #   public_patterns:
      #     - name: example-pattern
      #       pattern: 'some-safe-to-name-regex'
      #       description: 'shown in the deny reason -- keep this STRUCTURAL, never a specific identifier'
      #   secret_word_list_path: .claude/block-words.secret  # gitignored; a match here NEVER discloses the term

    secret_file_guard:     # Protected files' CONTENTS never enter context (Plan 00272)
      enabled: true         # Default globs: *.secret*, .vault-pass*, *.vault-password,
      priority: 14          # *vault_pass*, id_rsa, id_ed25519. Metadata via `hooks-daemon secret-meta`.
      # options:
      #   mode: additive              # additive (merge onto defaults) | replace (only your list)
      #   protected_paths:
      #     - "secrets/prod-token"
      #   allowed_consumers:          # additive to the shipped Ansible family
      #     - command: "my-deploy-tool"
      #       path_flags: ["--secret-file"]
      #   allow_plain_hash: false     # true also exposes exact size + plain sha256 via secret-meta
      #   exclude_paths: []           # scopes ONLY the authored-script content scan

    flaggable_content_channel_guard:  # Deny content-revealing git/grep over flaggable paths (Plan 00278)
      enabled: false        # Opt-in: closes the channel flaggable_work_advisor can only advise about
      priority: 14
      # options:
      #   flaggable_path_globs: ["firewall/**"]
      #   extra_content_revealing_patterns: ['^git\s+blame\b']  # always additive, never replaces the built-in shapes
      #   mode: additive  # or: replace (governs only flaggable_path_globs)

    quarantine_artefact_read_guard:  # Deny reading a *-opus-security-DETAIL* artefact (Plan 00278)
      enabled: false        # Opt-in; pre-seeded, so enabling needs no further config
      priority: 14
      # options:
      #   quarantine_artefact_globs: ["*-project-quarantine-RAW*"]
      #   mode: additive  # or: replace

    root_recursion_guard:  # Blocks recursive scans (grep -r, find, rg) rooted at / /proc /sys ~ $HOME
      enabled: true
      priority: 16

    pipe_blocker:          # Blocks dangerous pipe patterns in bash commands
      enabled: true
      priority: 15

    dangerous_permissions: # Warns about dangerous file permission changes
      enabled: true
      priority: 18

    git_stash:             # BLOCKS git stash creation by default (stashes get lost).
      enabled: true        # Escape hatch: MUST_STASH_BECAUSE="reason"; git stash
      priority: 17
      # options:
      #   mode: deny       # deny (default) | warn (advisory only)

    github_auto_close_keywords: # BLOCKS GitHub auto-closing keyword refs (Fixes #N,
      enabled: true             # closes GH-N, resolves owner/repo#N, issue URLs) in
      priority: 18              # git commit/merge/tag messages, incl. -F files.
      # options:                # No escape hatch: disable if auto-close is wanted
      #   mode: block           # block (default) | warn (advisory only)

    git_message_backtick:  # BLOCKS backticks in a DOUBLE-quoted git -m/--message.
      enabled: true        # Bash substitutes them: the span is executed and its
      priority: 20         # stdout replaces the text, silently. Use single quotes
                           # or -F <file>. Escaped \` and 'single quotes' are fine.

    ancestry_preserving_merge: # BLOCKS git merge --squash / gh pr merge --squash|--rebase (severs ancestry).
      enabled: true             # Escape hatch: MUST_SQUASH_BECAUSE="reason"; git merge --squash <branch>
      priority: 19
      # options:
      #   mode: block            # block (default) | warn (advisory only)

    lock_file_edit_blocker: # Prevents editing package lock files
      enabled: true
      priority: 19

    pip_break_system:      # Blocks pip commands that break system packages
      enabled: true
      priority: 20

    sudo_pip:              # Blocks sudo pip (use venv instead)
      enabled: true
      priority: 21

    daemon_restart_verifier: # Verifies daemon restart after code changes
      enabled: false       # Enable for daemon development projects
      priority: 22

    ask_user_question_blocker: # Blocks AskUserQuestion so Claude works autonomously (for unattended workflows)
      enabled: false           # Enable for fully unattended operation
      priority: 23

    worktree_file_copy:    # Prevents copying files between git worktrees
      enabled: true
      priority: 16

    # CODE QUALITY HANDLERS (Priority 25-45) - Optional but recommended
    qa_suppression:        # Unified multi-language QA suppression blocker (11 languages)
      enabled: false       # Enable for strict code quality control
      priority: 30
      # options:
      #   languages:       # Restrict to specific languages (default: ALL)
      #     - Python
      #     - Go
      #     - JavaScript/TypeScript
      #     - PHP

    comment_changelog:     # Blocks changelog narrative accumulating in a code comment
      enabled: false       # Enable for strict comment hygiene
      priority: 31
      # options:
      #   max_history_entries: 1   # more than this many dated/versioned entries advises
      #   mode: block               # block | warn

    comment_size:          # Caps over-long comments, tiered like plan-doc-size
      enabled: false       # Enable for strict comment hygiene
      priority: 33
      # options:
      #   max_comment_line_chars: 400
      #   max_comment_block_lines: 40
      #   mode: block               # block | warn

    bash_safe_mode:  # Opt-in: require a `set` safety prelude on sequenced Bash
      enabled: false       # Ships OFF; enabling is a per-project policy act
      priority: 36
      # options:
      #   mode: warn              # warn | block (inject is reserved and rejected at load)
      #   require:                # each independently requirable
      #     - errexit             # set -e
      #     - pipefail            # set -o pipefail
      #     # - nounset           # set -u; off-default (breaks $OPTIONAL_VAR probing)
      #   min_statements: 2       # single statements and pure && chains never flagged
      #   only_with_mutator: false  # true scopes to mutator-bearing commands
      #   exempt_patterns: []     # additive regexes over the whole command
    verification_result_gate:  # Flags a verifier whose exit status nothing consumes
      enabled: false       # Enable to be told when a lint could fail and a commit still run
      priority: 34
      # options:
      #   mode: warn              # warn | block — ships advisory
      #   extra_verifiers:        # additive; literal command names, never regexes
      #     - "my-project-check"
      #   extra_mutators:
      #     - "terraform apply"

    tdd_enforcement:       # Enforces test-first development
      enabled: false       # Enable for strict TDD workflow
      priority: 32

    lsp_enforcement:       # Steers LLMs toward LSP tools instead of Grep/Bash grep
      enabled: false       # Enable when LSP is configured
      priority: 38
      options:
        mode: block_once       # advisory | block_once | strict
        no_lsp_mode: block     # block | advisory | disable

    # WORKFLOW HANDLERS (Priority 30-50) - Enable based on your workflow
    plan_number_helper:    # Provides correct next plan number
      enabled: false       # Enable when using CLAUDE/Plan/ structure
      priority: 33
      # Plan directory is the top-level plan_workflow.directory (single source
      # of truth) — no per-handler track_plans_in_project needed.

    agent_isolation_advisor:  # Advises worktree isolation when agents share a checkout
      enabled: false          # Enable if you dispatch concurrent agents
      priority: 46

    gh_issue_comments:     # Requires --comments flag for gh issue view
      enabled: true
      priority: 40

    gh_pr_comments:        # Requires --comments flag for gh pr view
      enabled: true
      priority: 40

    global_npm_advisor:    # Advises against global npm installs
      enabled: true
      priority: 42

    staged_lint_gate:      # Cheap syntax-check backstop over staged files on git commit (Plan 00268)
      enabled: false       # Enable to catch a file that reaches the index via a route Write/Edit never sees
      priority: 43
      # options:
      #   mode: warn              # warn | block — ships advisory while the rollout settles
      #   max_files: 20            # stand down (advisory only) above this many staged lintable files

    plan_qa_edit:          # Stage 1 plan QA lint on PLAN.md writes (Plan 00144)
      enabled: false       # Enable for projects using CLAUDE/Plan/; policy under plan_workflow.qa
      priority: 44

    plan_qa_commit_gate:   # Stage 2 cross-file plan checks on git commit (Plan 00144)
      enabled: false       # Enable for projects using CLAUDE/Plan/; warn-first via plan_workflow.qa
      priority: 44

    plan_time_estimates:   # Blocks time estimates in plan files
      enabled: false       # Enable for projects using CLAUDE/Plan/
      priority: 45

    plan_workflow:         # Provides guidance when creating plans
      enabled: false       # Enable for projects using CLAUDE/Plan/
      priority: 44

    docs_qa_edit:          # EDIT-stage docs QA lint on documentation writes (Plan 00284)
      enabled: false       # Enable via top-level documentation.enabled: true; policy under documentation.qa
      priority: 47

    docs_qa_commit_gate:   # STAGED docs QA gate on git commit (Plan 00284)
      enabled: false       # Enable via top-level documentation.enabled: true; warn-first via documentation.qa
      priority: 47

    validate_instruction_content: # Blocks ephemeral content in CLAUDE.md/README.md
      enabled: false       # Enable to prevent implementation logs in instruction files
      priority: 49

    npm_command:           # Restricts npm commands to approved list
      enabled: false       # Enable for strict npm usage control
      priority: 50

    markdown_organization: # Enforces markdown file organization rules & plan tracking
      enabled: false       # Enable for md organization + plan tracking
      priority: 51
      # Docs: docs/guides/handlers/markdown_organization.md
      options:
        # Plan tracking is configured at the top-level plan_workflow: block
        # (single source of truth). Set plan_workflow.enabled: true there to
        # enable plan tracking for this handler — no per-handler option needed.
        #
        # Sub-project support: declared at the top-level `projects:` block, NOT
        # here. Sub-projects get the same organization rules as the root
        # project. See CLAUDE/Code/WorkspaceResolution.md, e.g.:
        #   projects:
        #     - name: frontend
        #       root: packages/frontend
        #     - name: backend
        #       root: packages/backend
        #
        # (Removed in Plan 00300's hard cutover: `monorepo_subproject_patterns`
        # regex patterns. Its presence in config is now a hard startup error.)
        #
        # Custom allowed markdown paths: OVERRIDES all built-in path rules.
        # Each entry is a regex matched against the project-relative path.
        # In monorepos, patterns match AFTER sub-project prefix stripping (same
        # rules apply to root and all sub-projects). See HANDLER_REFERENCE.md.
        # CLAUDE.md, README.md, CHANGELOG.md are always allowed regardless.
        # Built-in defaults (used when this option is absent):
        #   allowed_markdown_paths:
        #     - "^CLAUDE/.*\\.md$"                              # LLM documentation
        #     - "^docs/.*\\.md$"                                # Human-facing docs
        #     - "^untracked/.*\\.md$"                           # Temporary docs
        #     - "^RELEASES/.*\\.md$"                            # Release notes
        #     - "^eslint-rules/.*\\.md$"                        # ESLint rule docs
        #     - "^src/claude_code_hooks_daemon/guides/.*\\.md$" # Shipped guides
        allowed_markdown_paths: null

    # TOOL USAGE HANDLERS (Priority 50-60)
    web_search_year:       # Fixes year in web search queries (uses current year)
      enabled: true
      priority: 55

    daemon_docs_guard:     # Warns when reading from hooks-daemon internal CLAUDE/ docs (wrong directory)
      enabled: true
      priority: 57

    flaggable_work_advisor:  # Delegate-first advisory for safeguard-flaggable work (Plan 00278)
      enabled: false          # Opt-in: enable in projects whose content can trip a safety classifier
      priority: 58
      # options:
      #   flaggable_path_globs: ["firewall/**"]
      #   flaggable_topic_terms: ["tarpit"]      # extends the built-in seed (mode: additive)
      #   quarantine_agent: hooks-daemon-opus-security
      #   mode: additive  # or: replace

    british_english:       # Warns about American English spelling
      enabled: false       # Enable if you prefer British English
      priority: 60

  # PostToolUse handlers (run after tool execution)
  post_tool_use:
    lint_on_edit:              # Language-aware lint validation after Write/Edit
      enabled: false           # Enable for automatic lint validation (Shell, Python, Go, Rust, etc.)
      priority: 25

    markdown_table_formatter:  # Auto-format markdown tables via mdformat + mdformat-gfm
      enabled: false           # Enable for automatic markdown table alignment
      priority: 26

    git_hooks_executable_fixer:  # Auto-chmod +x git hooks git skipped as non-executable
      enabled: true
      priority: 27

    background_process_tracker:  # Tracks backgrounded processes; advises harvest-background + watchdog cron (never kills)
      enabled: true              # On by default (opt-out); advisory-only and rate-limited. Set false to disable.
      priority: 28

    command_hints:  # Config-driven advisory reminder after a configured command (e.g. agent-browser -> close session)
      enabled: true  # On by default (opt-out); advisory-only, never blocks. Set false to disable.
      priority: 29
      # options:
      #   mode: additive          # additive (default) | replace
      #   hints:
      #     - id: agent-browser-close-session   # overrides the built-in hint of the same id
      #       pattern: "agent-browser"
      #       hint: "Custom reminder text"
      #       ttl_seconds: 1800

    recovery_cron_advisor:  # Advises on failsafe recovery cron lifecycle (creation, progress, completion)
      enabled: true         # On by default (opt-out); advisory-only, fires only on CLAUDE/Plan/*/PLAN.md writes. Set false to disable.
      priority: 30

    goal_injection:  # Writes <session>.goal-intent for the ccy PTY supervisor when a plan flips to In Progress (Plan 00269)
      enabled: false  # Opt-in: only useful when a supervisor is watching. Manual fallback: bin/hooks-daemon inject-goal NNNNN
      priority: 31
      # options:
      #   mode: additive                  # additive (default) | replace (fixed header line always kept)
      #   once_per_plan_per_session: true
      #   lines:
      #     - id: subagents-encouraged    # enable a vetted built-in line without restating its text
      #       enabled: true
      #     - id: project-motto
      #       text: "All findings are logged to {plan_path}/REPORTS/."

    validate_eslint_on_write:  # Runs ESLint after file writes
      enabled: false           # Enable for automatic ESLint validation
      priority: 20

  # SessionStart handlers (run when session starts)
  session_start:
    disclosure_reset_session_start:  # Reset per-agent rule-disclosure state on every SessionStart (Plan 00116 Phase 4)
      enabled: true
      priority: 15

    project_handler_load_checker:  # Loud alert when project handlers fail to load (Plan 00143)
      enabled: true                 # Silent unless a project handler was skipped at startup
      priority: 50

    hook_registration_checker:  # Validates hook registrations in Claude Code settings
      enabled: true             # Alerts when expected hooks are missing or misconfigured
      priority: 51

    optimal_config_checker:  # Checks Claude Code env for optimal settings
      enabled: true
      priority: 52

    git_filemode_checker:  # Warns when git core.fileMode=false (hooks lose exec perms)
      enabled: true
      priority: 53

    gitignore_safety_checker:  # Warns when required .claude/ paths are missing from .gitignore
      enabled: true            # Uses content-hash cache - only re-checks when .gitignore changes
      priority: 54

    git_upstream_checker:  # Full fetch + pull policy on session start (Plan 00178)
      enabled: true        # New sessions only; silent unless the branch is behind upstream
      priority: 56
      options:
        mode: warn         # warn | agent-pull | auto-pull
        auto_fetch: true   # run additive `git fetch --all --no-prune` before checking ahead/behind

    suggest_status_line:  # Suggests daemon-based status line setup
      enabled: true      # Recommends status line if not configured
      priority: 55

    version_check:  # Checks if daemon is up-to-date with latest release
      enabled: true  # Notifies on new sessions if updates available (24h cache)
      priority: 56

    plan_qa_sweep:  # Plan-tree drift report at session start (Plan 00144; silent when clean)
      enabled: true  # Policy lives under the top-level plan_workflow.qa section
      priority: 57

    ccy_supervisor_integrity:  # Warns when the ccy supervisor is armed but its files are unsafe (Plan 00148)
      enabled: true            # Silent unless .claude/ccy/ is a ccy project with an armed ccy.env
      priority: 58

    plan_workflow_asset_checker:  # Advise deploy-plan-workflow when mkplan.bash is missing (Plan 00185)
      enabled: true               # Silent unless plan_workflow enabled AND mkplan.bash absent
      priority: 59

    contract_staleness:  # Advise a hooks-contract refresh when Claude Code outruns the vendored audit (Plan 00271)
      enabled: true      # Silent unless installed Claude Code > META.json last_audited_claude_code_version
      priority: 60

    skill_opportunity_detector:  # TTL-gated advisory: run `bin/hooks-daemon skill-scan` (Plan 00274)
      enabled: false             # Opt-in: the scan reads this machine's session transcripts
      priority: 61
      options:
        check_interval_days: 7       # Advisory cadence floor; never advises more often
        transcript_window_days: 14   # Only transcript files modified inside this window are read
        model: haiku                 # Passed to headless `claude -p --model` (CLI auth only, v1)
        max_prompts: 100             # Digest cluster cap (bounds model input tokens)
        extra_exclude_patterns: []   # Additional content-level noise markers, additive
        # transcript_dir: /path/override   # Test/unusual-layout override of ~/.claude/projects/<slug>

    secret_file_hygiene_checker:  # On-disk hygiene for protected paths (Plan 00272 Task 6.1)
      enabled: true                # gitignore/tracked/permissions -- never reads content
      priority: 62

    model_fallback_detector:  # Opt-in: loud SessionStart alert on a recorded model fallback (Plan 00278)
      # Probably leave this OFF. A SessionStart scan reports a fallback that
      # already happened, so for a project that never does safeguard-flaggable
      # work it essentially never fires, and when it does it is noisy (one
      # snapshot file per distinct record). The `downgrade_indicator` status
      # line (enabled above) shows a LIVE downgrade instead. Enable this only
      # to capture diagnostic snapshots for tuning delegation config.
      enabled: false
      priority: 63
      # options:
      #   snapshot_enabled: true
      #   snapshot_dir: untracked/reports
      #   snapshot_window_records: 20

    docs_qa_sweep:  # Whole-corpus docs drift report at session start (Plan 00284; silent when clean)
      enabled: false  # Enable via top-level documentation.enabled: true; also builds/refreshes the corpus index
      priority: 64

    tool_disable_advisor:  # Check tool_policy.never_want tools against project settings (Plan 00293)
      enabled: false  # Opt-in; advisory only, never edits settings; inert without tool_policy.never_want entries
      priority: 65

    monorepo_detector:  # Advise on an unconfigured monorepo shape (manifests found below the repo root, none at it) (Plan 00298)
      enabled: true  # Advisory only, never resolves a boundary; silent when projects: already declared
      priority: 66

  # PreCompact handlers (run before conversation compaction)
  pre_compact:
    disclosure_reset_pre_compact:  # Reset per-agent rule-disclosure state before compaction (Plan 00116 Phase 4)
      enabled: true
      priority: 15

    compaction_signal:  # Drops <session>.compacting for the PTY supervisor (opt-in)
      enabled: false
      priority: 20

  # UserPromptSubmit handlers (run when user submits prompt)
  user_prompt_submit:
    git_context_injector:  # Injects git context into user prompts
      enabled: true
      priority: 10

    failsafe_cron_blockage_suppressor:  # Suppress a delivered failsafe-cron tick while the session is blocked only on human input (Plan 00298)
      enabled: true  # On by default (dogfooding purpose); never terminal
      priority: 37

    critical_thinking_advisory:  # Periodic advisory encouraging critical evaluation
      enabled: false              # Enable for critical thinking nudges on substantial prompts
      priority: 55

    idle_housekeeping_advisory:  # BETA: report-first idle housekeeping (Plan 00161)
      enabled: false             # Opt-in beta - leave off unless trying it. See docs/guides/CREATING_REPORTS.md
      priority: 56

    standing_authorisations:  # Replay a standing request THIS project recorded (Plan 00223)
      # The HANDLER ships on so the options are discoverable; every
      # AUTHORISATION below ships off, so this is inert until you opt in.
      # Deliberate: every other default-on handler ADDS a restriction, this
      # one relaxes one, and the daemon must never assert consent nobody gave.
      enabled: true
      priority: 57
      options:
        authorisations:
          # Set enabled: true to record the request. It is then replayed on
          # each prompt, naming this file so it can be audited and withdrawn.
          - id: subagent-delegation
            enabled: false
          - id: workflow-orchestration
            enabled: false
          - id: commit-push-cadence
            enabled: false

  # Other hook events
  permission_request:
    auto_approve_reads:  # Auto-approves read-only file operations
      enabled: true
      priority: 10

  stop:
    auto_continue_stop:  # Auto-continues after stop events based on criteria
      enabled: true
      priority: 10

  # Status line handlers (format daemon-based status display)
  status_line:
    model_context:  # Shows model name and color-coded context percentage
      enabled: true
      priority: 10

    downgrade_indicator:  # Warns when the session model has silently downgraded (Plan 00278)
      # Self-detected from model-family-rank high-water per session; silent
      # unless a downgrade is active, so it costs nothing normally.
      enabled: true
      priority: 11

    context_sidecar:  # Observe-only: writes context state for the PTY supervisor (opt-in)
      enabled: false
      priority: 12

    environment_indicator:  # Shows 💻 desktop / 🐳 docker / 📦 podman (cached at startup)
      enabled: true
      priority: 11

    supervisor_indicator:  # Top hat 🎩 w/ bg colour: green armed / yellow dry-run / orange down (ccy supervisor)
      # On by default; renders NOTHING when no ccy supervisor status file exists.
      enabled: true
      priority: 13

    git_branch:     # Shows current git branch if in repo
      enabled: true
      priority: 20
      options:
        # Keep remote-tracking refs fresh so ahead/behind icons are honest.
        # TTL-gated background fetch in a daemon thread — never blocks the
        # render, never prompts for credentials, tolerates being offline.
        auto_fetch: true
        fetch_interval_seconds: 300

    git_repo_name:  # Shows git repository name
      enabled: true
      priority: 25

    working_directory:  # Shows current working directory when different from project root
      enabled: true
      priority: 25

    startup_cleanup:  # Shows 🧹 briefly after startup when stale files were removed
      enabled: true
      priority: 28

    daemon_stats:   # Shows daemon uptime, memory, log level
      enabled: true
      priority: 30

    upgrade_notifier:  # Shows "📦 vX → vY" when a newer daemon version is available
      # On by default; renders NOTHING unless an upgrade is genuinely available.
      enabled: true
      priority: 32

    account_display: # Shows account information
      enabled: true
      priority: 40

    multithread_indicator:  # Shows "🧵 Y/X" — first segment; this thread's rank among live threads
      enabled: true
      priority: 2

    current_time:   # Shows current local time (24-hour format)
      enabled: true
      priority: 14

  worktree_create:  # WorktreeCreate event (isolation:worktree agents / --worktree sessions)
    worktree_create:  # Creates the git worktree at a semantic path and echoes it
      # MUST stay enabled: Claude Code parses this hook's stdout as the created
      # worktree path, so a disabled/passthrough hook breaks worktree creation.
      enabled: true
      priority: 50
      # options:
      #   # A fresh worktree is a clean CHECKOUT, so your git-ignored local
      #   # files are simply absent from it — an agent working there runs
      #   # against a different configuration from the session that spawned it,
      #   # and nothing says so. List the paths to place into a new worktree.
      #   #
      #   # No default is shipped and none can be: only this project knows
      #   # which of its git-ignored files matter. Run
      #   #   bin/hooks-daemon check-worktree-seed
      #   # to see what your repository suggests and what has gone stale. It
      #   # reports; it never edits this file.
      #   seed:
      #     # Applies to any entry that does not name its own mode.
      #     #   symlink — shared with the main checkout. One source of truth,
      #     #             but a write from INSIDE a worktree flows back.
      #     #   copy    — isolated. Safe to overwrite; may drift from the
      #     #             canonical file after creation.
      #     default_mode: symlink
      #     entries:
      #       # Repository-root-relative. Files or directories; no globs.
      #       - .env.local
      #       - path: .secrets       # anything an agent may WRITE to
      #         mode: copy
      #
      #   # Seeding happens once, at creation. A re-fired event never re-seeds
      #   # over an agent's own edits, and a listed path that does not exist
      #   # ABORTS creation rather than yielding a quietly under-seeded worktree.

  worktree_remove:  # WorktreeRemove event (worktree teardown)
    worktree_remove:  # Prunes stale worktree registrations; removes a named worktree
      enabled: true
      priority: 50

# Project-level handlers (custom handlers in .claude/hooks/handlers/)
# Example:
# plugins:
#   - type: "file"
#     path: ".claude/hooks/handlers/pre_tool_use/my_handler.py"
#     class: "MyHandler"
#     events: ["PreToolUse"]

# Plan workflow (single source of truth for plan tracking).
# OPT-IN: disabled by default so a stock install does not scatter CLAUDE/Plan/
# or deploy the mkplan scaffolding script while the plan handlers are off.
# Uncomment and set enabled: true to turn on plan tracking. Enabling this
# feeds the plan directory to all planning handlers (plan_number_helper,
# markdown_organization, validate_plan_number, ...) AND deploys the CLAUDE/Plan/
# scaffold + mkplan.bash on install/upgrade. The directory here is authoritative
# — do not duplicate it in per-handler options.
# plan_workflow:
#   enabled: true
#   directory: "CLAUDE/Plan"
#   workflow_docs: "CLAUDE/PlanWorkflow.md"
#   enforce_claude_code_sync: false

# Documentation SSoT enforcement (Plan 00284): one canonical home per fact,
# everything else points. OPT-IN: disabled by default. Enabling this feeds
# policy to docs_qa_edit/docs_qa_sweep above (both already registered, but
# their matches() stays false while documentation.enabled is false).
# documentation:
#   enabled: true
#   trees:
#     agent: CLAUDE
#     human: docs
#   qa:
#     edit_mode: warn            # warn | block
#     commit_gate_mode: warn     # warn | block (STAGED stage not yet implemented)
#     sweep_mode: advise         # advise | off
#     check_modes: {}            # per-check override, e.g. rules-file-shape: block
#     grandfather_allowlist: []  # file globs; advise-only forever
#     generated_docs:
#       - glob: ".claude/HOOKS-DAEMON.md"
#         generator: "bin/hooks-daemon generate-docs"
#     registered_module_docs: []
#     resident_at_imports: ["CLAUDE.md"]
