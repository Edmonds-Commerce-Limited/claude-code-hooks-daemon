{
  "plansDirectory": "./CLAUDE/Plan",
  "permissions": {
    "allow": [
      "Bash(untracked/venv/bin/python:*)",
      "Bash(printf '\\\\n')",
      "Read(//tmp/**)",
      "Bash(echo \"SUB_DIFF=$?\")"
    ]
  },
  "claudeMdExcludes": [
    "**/untracked/worktrees/*/CLAUDE.md",
    "**/.claude/worktrees/*/CLAUDE.md"
  ],
  "extraKnownMarketplaces": {
    "defence-before-fix": {
      "source": {
        "source": "github",
        "repo": "Defence-Before-Fix/claude-plugin"
      }
    }
  },
  "enabledPlugins": {
    "defence-before-fix@defence-before-fix": true
  }
}
