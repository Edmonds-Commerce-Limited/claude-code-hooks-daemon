{
  "event": "PermissionRequest",
  "block_mechanism": "decision-behavior",
  "can_block": true,
  "ask_capable": false,
  "top_level_output_fields": [
    "continue",
    "stopReason",
    "suppressOutput",
    "systemMessage",
    "terminalSequence"
  ],
  "top_level_decision_enum": null,
  "hook_specific_output_fields": {
    "decision": {
      "fields": {
        "behavior": {
          "enum": [
            "allow",
            "deny"
          ]
        },
        "updatedInput": {
          "note": "allow only"
        },
        "updatedPermissions": {
          "note": "allow only"
        },
        "message": {
          "note": "deny only: tells Claude why the permission was denied"
        },
        "interrupt": {
          "note": "deny only: if true, stops Claude"
        }
      }
    }
  },
  "discarded_fields": [],
  "conditional_input_fields": {
    "mcp_server": "Present only when the tool is an MCP tool: an object with the server's name and a source saying where its definition came from (see the PreToolUse mcp_server entry). Requires Claude Code v2.1.274 or later."
  },
  "notes": "decision.behavior is 'allow' | 'deny' ONLY \u2014 the docs define no 'ask'. The deny explanation field is decision.message; the docs define no additionalContext for this event.",
  "input_example": {
    "session_id": "abc123",
    "transcript_path": "/Users/.../.claude/projects/.../00000000-0000-0000-0000-000000000000.jsonl",
    "cwd": "/Users/...",
    "permission_mode": "default",
    "hook_event_name": "PermissionRequest",
    "tool_name": "Bash",
    "tool_input": {
      "command": "rm -rf node_modules",
      "description": "Remove node_modules directory"
    },
    "permission_suggestions": [
      {
        "type": "addRules",
        "rules": [
          {
            "toolName": "Bash",
            "ruleContent": "rm -rf node_modules"
          }
        ],
        "behavior": "allow",
        "destination": "localSettings"
      }
    ]
  }
}
