#!/bin/bash
#
# hooks-daemon — the daemon CLI entry point for agents and humans.
#
# Deployed by the installer to {daemon_root}/bin/hooks-daemon:
#   client install : <project>/.claude/hooks-daemon/bin/hooks-daemon
#   self-install   : <project>/bin/hooks-daemon
#
# WHY THIS EXISTS (Plan 00192)
# ----------------------------
# Guidance used to tell agents to run:
#     $PYTHON -m claude_code_hooks_daemon.daemon.cli <subcommand>
# $PYTHON is never set in an agent's shell, and the PATH python3 cannot import
# the package because the daemon venv sets include-system-site-packages=false.
# The line expanded to "-m claude_code_hooks_daemon..." and bash reported
# "-m: command not found" — an error naming neither Python, the venv, nor the
# daemon. Agents concluded the package was missing and damaged working installs
# trying to reinstall it.
#
# This wrapper takes the interpreter problem away from the caller entirely.
#
# DESIGN NOTES
# ------------
# 1. INTERPRETER resolution anchors to this script's OWN location, not the
#    caller's CWD. daemon-cli.sh walks up from $PWD looking for
#    .claude/hooks-daemon.yaml, which breaks inside a git worktree: the worktree
#    has the tracked yaml but NOT the git-ignored
#    .claude/hooks-daemon/scripts/lib/. Anchoring to $0 is worktree-proof.
#
#    The anchoring covers BOTH halves (Plan 00194). It resolves the
#    interpreter, and it also derives this daemon root's OWN project root and
#    passes it as --project-root, so the daemon MANAGED (socket/PID/log) is the
#    one belonging to this wrapper — not whichever project the caller happens to
#    be standing in:
#
#        cd /project-a && /project-b/.claude/hooks-daemon/bin/hooks-daemon restart
#        # ^ restarts project-B's daemon, because that is B's wrapper
#
#    Before Plan 00194 that line restarted project-A's daemon, silently and
#    looking like success. It bit twice for real: a fixture wrapper run from the
#    dogfood repo restarted the dogfood daemon, and an unanchored `stop`
#    resolved the wrong project, reported "Daemon not running", exited 0, and
#    let teardown delete a live daemon's directory.
#
#    Precedence is unchanged: an explicit --project-root from the caller is
#    appended AFTER the derived one, and argparse takes the last occurrence, so
#    the caller always wins. Env overrides (CLAUDE_HOOKS_SOCKET_PATH etc.) are
#    read further down the stack and are unaffected.
#
#    CWD IS NEVER AN INPUT. The wrapper first shipped with a fallback: if it
#    could not derive a project root it exec'd unanchored and let the CLI walk
#    up from $PWD. That was described as "fail-safe", which was wrong — the
#    walk-up is precisely the mechanism that made a wrapper act on the caller's
#    project instead of its own. A silent wrong target that exits 0 is worse
#    than a refusal, so an unanchorable layout now exits 5 with a diagnostic.
# 2. It performs NO network access. The skill wrappers self-bootstrap against a
#    release manifest on every invocation, which is unacceptable for hot-path
#    commands like `plan-qa --lint` and fails closed in offline containers.
# 3. It fails loudly. A wrapper that silently degrades would recreate the exact
#    confusion this script exists to eliminate.

set -euo pipefail

# Resolve this script's real directory, following symlinks so the wrapper still
# anchors correctly if a project links it onto PATH.
_source="${BASH_SOURCE[0]}"
while [ -L "$_source" ]; do
    _dir="$(cd -P "$(dirname "$_source")" && pwd)"
    _source="$(readlink "$_source")"
    # A relative symlink target resolves against the link's own directory.
    case "$_source" in
        /*) ;;
        *) _source="$_dir/$_source" ;;
    esac
done
BIN_DIR="$(cd -P "$(dirname "$_source")" && pwd)"

# The daemon root is the parent of bin/ in BOTH install modes, so this wrapper
# needs no knowledge of which mode it is running in.
DAEMON_DIR="$(cd -P "$BIN_DIR/.." && pwd)"

RESOLVE_LIB="$DAEMON_DIR/scripts/lib/resolve_venv.sh"
if [ ! -f "$RESOLVE_LIB" ]; then
    echo "❌ hooks-daemon: venv resolver missing at $RESOLVE_LIB" >&2
    echo "   This wrapper expects to live at <daemon_root>/bin/hooks-daemon." >&2
    echo "   Reinstall or upgrade the daemon to restore scripts/lib/." >&2
    exit 5
fi

# shellcheck disable=SC1090  # path is computed at runtime from DAEMON_DIR
source "$RESOLVE_LIB"

if ! PYTHON="$(resolve_venv_python "$DAEMON_DIR")"; then
    echo "❌ hooks-daemon: could not resolve a usable venv under $DAEMON_DIR" >&2
    echo "   Run the installer/upgrade to rebuild it." >&2
    exit 5
fi

if [ ! -x "$PYTHON" ]; then
    echo "❌ hooks-daemon: resolved interpreter is not executable: $PYTHON" >&2
    exit 5
fi

# Derive THIS wrapper's own project root, so the daemon managed is this
# project's (Plan 00194). The daemon root is <project>/.claude/hooks-daemon in a
# client install and <project> itself in self-install, so the layout alone
# distinguishes them — no mode flag needed.
_parent_dir="$(cd -P "$DAEMON_DIR/.." && pwd)"
if [ "$(basename "$DAEMON_DIR")" = "hooks-daemon" ] && [ "$(basename "$_parent_dir")" = ".claude" ]; then
    PROJECT_ROOT="$(cd -P "$_parent_dir/.." && pwd)"   # client install
else
    PROJECT_ROOT="$DAEMON_DIR"                          # self-install
fi

# An unanchorable layout is a HARD failure. There is deliberately no fallback:
# the only alternative would be to exec unanchored and let the CLI walk up from
# $PWD, and that walk-up IS the defect this anchoring exists to remove. A
# wrapper that quietly manages whichever project the caller happens to be
# standing in reports success while acting on the wrong daemon — strictly worse
# than refusing, because nothing tells you it happened.
if [ ! -d "$PROJECT_ROOT/.claude" ]; then
    echo "❌ hooks-daemon: cannot anchor to a project" >&2
    echo "   Derived project root: $PROJECT_ROOT (no .claude/ directory)" >&2
    echo "   Expected this wrapper at one of:" >&2
    echo "     <project>/.claude/hooks-daemon/bin/hooks-daemon  (client install)" >&2
    echo "     <project>/bin/hooks-daemon                       (self-install)" >&2
    echo "   Refusing to fall back to the working directory: that would target" >&2
    echo "   whichever project you happen to be standing in." >&2
    exit 5
fi

# Derived anchor FIRST: argparse takes the last occurrence, so a caller's own
# --project-root still overrides it.
exec "$PYTHON" -m claude_code_hooks_daemon.daemon.cli --project-root "$PROJECT_ROOT" "$@"
